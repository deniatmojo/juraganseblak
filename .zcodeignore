# Dependencies
node_modules/

# Build output di-commit (dipakai untuk deploy git-pull di server),
# tapi folder dev-server tidak:
.webpack/

# Android build artifacts (source android/ tetap di-commit)
web/android/.gradle/
web/android/build/
web/android/app/build/
web/android/local.properties

# Python / tooling
__pycache__/
*.pyc
.venv/

# Graphify output (di-generate lokal, tidak perlu di repo)
graphify-out/

# ZCode / IDE lokal
.zcode/
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Env & secret
.env
.env.*
*.pem

# Foto menu yang di-upload via API (runtime data, bukan source)
server/uploads/

# repo graphify CLI lokal (git bersarang)
graphify/
# Helper lokal berisi kredensial — jangan commit
tools/ssh_run.py

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
